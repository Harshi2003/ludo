# Copy to .env.local and fill in.
# AI world creation needs at least one of these two keys.
# Primary: Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Fallback: Bitdeer AI Model Studio, used when Claude is missing, down, or can't produce a valid world
# (https://www.bitdeer.ai → Console → API Keys)
BITDEER_API_KEY=
# Optional: any model id from GET /v1/models on Bitdeer (default zai-org/GLM-5.3)
BITDEER_MODEL=
# Optional: where AI-made worlds are saved on the server (default apps/web/data/worlds)
WORLDS_DIR=
# Optional: paints backgrounds and portraits (https://fal.ai)
FAL_KEY=
# Optional: set to 1 to return the built-in pirate world instead of calling the AI
FORGE_MOCK=
# Online play: game server WebSocket URL (default: ws://<this host>:8787)
NEXT_PUBLIC_WS_URL=
