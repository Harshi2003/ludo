# Copy to .env.local and fill in.
# Required for AI world creation (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: paints backgrounds and portraits (https://fal.ai)
FAL_KEY=
# Optional: set to 1 to return the built-in pirate world instead of calling the AI
FORGE_MOCK=
# Online play for all worlds: shared server (default: ws://<this host>:8787)
NEXT_PUBLIC_WS_URL=
# Optional Party endpoint override (default: NEXT_PUBLIC_WS_URL + /party)
# Set this only if deploying the legacy standalone Party server separately.
NEXT_PUBLIC_PARTY_WS_URL=
